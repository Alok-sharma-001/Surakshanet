# Database
POSTGRES_USER=surakshanet
POSTGRES_PASSWORD=surakshanet_dev
POSTGRES_DB=surakshanet
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://surakshanet:surakshanet_dev@postgres:5432/surakshanet

# Redis
REDIS_URL=redis://redis:6379/0

# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Surakshanet
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# SUMO
SUMO_HOME=/usr/share/sumo
SUMO_BINARY=sumo
SUMO_GUI_BINARY=sumo-gui
