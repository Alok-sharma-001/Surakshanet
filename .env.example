# =================================================================
# Surakshanet Intelligent Transportation System - Environment Configuration Template
# Copy this file to .env or run ./infra/scripts/generate_secrets.sh
# =================================================================

# Security & Authentication
ENVIRONMENT=production
DEBUG=false
JWT_SECRET_KEY=change_this_to_a_random_256_bit_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL / PostGIS (Master Topology & Junction Configuration)
POSTGRES_USER=surakshanet
POSTGRES_PASSWORD=surakshanet_dev
POSTGRES_DB=surakshanet
DATABASE_URL=postgresql+asyncpg://surakshanet:surakshanet_dev@postgres:5432/surakshanet

# TimescaleDB (High-throughput Sensor Telemetry)
TIMESCALE_USER=surakshanet
TIMESCALE_PASSWORD=surakshanet_dev
TIMESCALE_DB=surakshanet
TIMESCALE_URL=postgresql+asyncpg://surakshanet:surakshanet_dev@timescaledb:5432/surakshanet

# Redis Pub/Sub & Caching
REDIS_URL=redis://redis:6379/0

# MQTT Broker (Edge Sensors, Cameras & Signal Cabinets)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Web Server Runtime
HOST=0.0.0.0
PORT=8000
WORKERS=2
